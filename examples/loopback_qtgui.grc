options:
  parameters: {id: loopback_qtgui, title: rxtune radio-free loopback (Qt), author: gr-rxtune, generate_options: qt_gui,
    output_language: python, category: '[GRC Hier Blocks]', run: 'True', run_options: prompt, gen_cmake: 'On', description: Stock
      DSP plant; rxtune finds the gain ridge from the SNR dial alone.}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters: {value: '400000'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [230, 12]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters: {value: '4'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [340, 12]
    rotation: 0
    state: enabled
- name: qpsk
  id: variable_constellation
  parameters: {type: qpsk}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [450, 12]
    rotation: 0
    state: enabled
- name: note_air
  id: note
  parameters: {note: 1. THE AIR}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 175]
    rotation: 0
    state: enabled
- name: bits
  id: analog_random_uniform_source_x
  parameters: {type: byte, minimum: '0', maximum: '256', seed: '1'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 250]
    rotation: 0
    state: enabled
- name: mod
  id: digital_constellation_modulator
  parameters: {constellation: qpsk, differential: 'False', samples_per_symbol: sps, excess_bw: '0.35'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [230, 250]
    rotation: 0
    state: enabled
- name: throttle
  id: blocks_throttle2
  parameters: {type: complex, samples_per_second: samp_rate}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [490, 250]
    rotation: 0
    state: enabled
- name: antenna
  id: blocks_multiply_const_vxx
  parameters: {type: complex, const: '0.01', comment: weak wanted signal}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [700, 262]
    rotation: 0
    state: enabled
- name: neighbour
  id: analog_sig_source_x
  parameters: {type: complex, samp_rate: '1', waveform: analog.GR_COS_WAVE, freq: '0.37', amp: neighbour_level,
    comment: strong out-of-band neighbour}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 360]
    rotation: 0
    state: enabled
- name: air
  id: blocks_add_xx
  parameters: {type: complex, num_inputs: '2'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [900, 290]
    rotation: 0
    state: enabled
- name: chan
  id: channels_channel_model
  parameters: {noise_voltage: '0.001', freq_offset: '0.0', epsilon: '1.0', taps: '1.0', seed: '1'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1010, 250]
    rotation: 0
    state: enabled
- name: to_radio
  id: virtual_sink
  parameters: {stream_id: antenna_port}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1260, 290]
    rotation: 0
    state: enabled
- name: note_radio
  id: note
  parameters: {note: 2. THE RADIO}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 485]
    rotation: 0
    state: enabled
- name: from_air
  id: virtual_source
  parameters: {stream_id: antenna_port}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 590]
    rotation: 0
    state: enabled
- name: gain_blk
  id: blocks_multiply_const_vxx
  parameters: {type: complex, const: '1.0', comment: THE KNOB (set by rxtune)}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 578]
    rotation: 0
    state: enabled
- name: c2f
  id: blocks_complex_to_float
  parameters: {}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 574]
    rotation: 0
    state: enabled
- name: rail_i
  id: analog_rail_ff
  parameters: {lo: '-1', hi: '1'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [590, 530]
    rotation: 0
    state: enabled
- name: rail_q
  id: analog_rail_ff
  parameters: {lo: '-1', hi: '1'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [590, 630]
    rotation: 0
    state: enabled
- name: f2c
  id: blocks_float_to_complex
  parameters: {}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [780, 574]
    rotation: 0
    state: enabled
- name: conv_noise
  id: analog_noise_source_x
  parameters: {type: complex, noise_type: analog.GR_GAUSSIAN, amp: '0.003', seed: '2', comment: converter noise}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [740, 690]
    rotation: 0
    state: enabled
- name: adc
  id: blocks_add_xx
  parameters: {type: complex, num_inputs: '2'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [980, 600]
    rotation: 0
    state: enabled
- name: to_demod
  id: virtual_sink
  parameters: {stream_id: converter_out}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1100, 604]
    rotation: 0
    state: enabled
- name: note_demod
  id: note
  parameters: {note: 3. THE DECODER}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 805]
    rotation: 0
    state: enabled
- name: from_conv
  id: virtual_source
  parameters: {stream_id: converter_out}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 920]
    rotation: 0
    state: enabled
- name: rrc
  id: root_raised_cosine_filter
  parameters: {type: fir_filter_ccf, decim: '1', interp: '1', gain: '1', samp_rate: sps, sym_rate: '1', alpha: '0.35',
    ntaps: 11*sps}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 880]
    rotation: 0
    state: enabled
- name: agc
  id: analog_agc_xx
  parameters: {type: complex, rate: 1e-3, reference: '1.0', gain: '1.0', max_gain: '65536'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [450, 880]
    rotation: 0
    state: enabled
- name: sync
  id: digital_symbol_sync_xx
  parameters: {type: cc, ted_type: digital.TED_SIGNAL_TIMES_SLOPE_ML, constellation: qpsk.base(), sps: sps, ted_gain: '1.0',
    loop_bw: '0.045', damping: '1.0', max_dev: '0.01', osps: '1', resamp_type: digital.IR_MMSE_8TAP, nfilters: '128',
    pfb_mf_taps: '[]', comment: 'max deviation 0.01: with a wide clock range it never re-locks after an overload
      cell'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [650, 860]
    rotation: 0
    state: enabled
- name: to_dial
  id: virtual_sink
  parameters: {stream_id: symbols}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1010, 910]
    rotation: 0
    state: enabled
- name: note_loop
  id: note
  parameters: {note: 4. DIAL + LOOP}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 1095]
    rotation: 0
    state: enabled
- name: from_sync
  id: virtual_source
  parameters: {stream_id: symbols}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 1190]
    rotation: 0
    state: enabled
- name: probe
  id: rxtune_dial_probe
  parameters: {estimator: m2m4, msg_nsamples: '4000', alpha: '0.2', comment: alpha is part of the dial's settle
      time}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [190, 1170]
    rotation: 0
    state: enabled
- name: ctl
  id: rxtune_controller
  parameters: {axes: '[{"name": "gain", "lo": -20, "hi": 40, "step": 1, "sense": "gain", "settle_s": 0.1}]', dialect: generic,
    dial_name: SNR, settle_s: '1.0', window_s: '0.8'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 1170]
    rotation: 0
    state: enabled
- name: setter
  id: rxtune_msg_setter
  parameters: {target: gain_blk, setters: '{"gain": lambda blk, db: blk.set_k(10.0 ** (float(db) / 20.0))}', getters: '{"gain":
      lambda blk: round(20.0 * __import__("math").log10(abs(blk.k())), 6)}', comment: 'Multiply Const has no message
      port: call set_k(), read k() back'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [830, 1170]
    rotation: 0
    state: enabled
- name: debug
  id: blocks_message_debug
  parameters: {en_uvec: 'True'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1180, 1310]
    rotation: 0
    state: enabled
- name: neighbour_level
  id: variable_qtgui_range
  parameters: {label: Neighbour level, value: '0.3', start: '0', stop: '1.0', step: '0.01', widget: counter_slider,
    gui_hint: '0,0,1,2'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [700, 12]
    rotation: 0
    state: enabled
- name: from_conv_gui
  id: virtual_source
  parameters: {stream_id: converter_out}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1230, 710]
    rotation: 0
    state: enabled
- name: time_sink
  id: qtgui_time_sink_x
  parameters: {type: complex, name: '"after the converter"', size: '1024', srate: samp_rate, gui_hint: '1,0,1,1'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1450, 530]
    rotation: 0
    state: enabled
- name: freq_sink
  id: qtgui_freq_sink_x
  parameters: {type: complex, name: '"after the converter"', fftsize: '1024', bw: samp_rate, gui_hint: '1,1,1,1'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1450, 670]
    rotation: 0
    state: enabled
- name: to_mag
  id: blocks_complex_to_mag
  parameters: {}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1450, 850]
    rotation: 0
    state: enabled
- name: level_sink
  id: qtgui_number_sink
  parameters: {type: float, name: '"converter level"', graph_type: qtgui.NUM_GRAPH_HORIZ, min: '0', max: '1.5',
    gui_hint: '2,0,1,1'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1640, 820]
    rotation: 0
    state: enabled
- name: dash
  id: rxtune_dashboard
  parameters: {label: rxtune, units: dB, dial_max: '35', gui_hint: '2,1,2,1'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [830, 1310]
    rotation: 0
    state: enabled
connections:
- [bits, '0', mod, '0']
- [mod, '0', throttle, '0']
- [throttle, '0', antenna, '0']
- [antenna, '0', air, '0']
- [neighbour, '0', air, '1']
- [air, '0', chan, '0']
- [chan, '0', to_radio, '0']
- [from_air, '0', gain_blk, '0']
- [gain_blk, '0', c2f, '0']
- [c2f, '0', rail_i, '0']
- [c2f, '1', rail_q, '0']
- [rail_i, '0', f2c, '0']
- [rail_q, '0', f2c, '1']
- [f2c, '0', adc, '0']
- [conv_noise, '0', adc, '1']
- [adc, '0', to_demod, '0']
- [from_conv, '0', rrc, '0']
- [rrc, '0', agc, '0']
- [agc, '0', sync, '0']
- [sync, '0', to_dial, '0']
- [from_sync, '0', probe, '0']
- [probe, dial, ctl, dial]
- [ctl, cmd, setter, cmd]
- [setter, readback, ctl, readback]
- [ctl, verdict, debug, print]
- [from_conv_gui, '0', time_sink, '0']
- [from_conv_gui, '0', freq_sink, '0']
- [from_conv_gui, '0', to_mag, '0']
- [to_mag, '0', level_sink, '0']
- [probe, dial, dash, dial]
- [ctl, status, dash, status]
- [ctl, verdict, dash, verdict]
metadata: {file_format: 1, grc_version: 3.10.12.0}
